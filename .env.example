# Source checkout: copy this file to .env next to growr.py.
# Installed/uv: use ~/.config/growr/.env, or $XDG_CONFIG_HOME/growr/.env.
# Blank credentials use public/default services.
# Process environment values override .env. Never commit real keys.

# Fallback custom Solana mainnet RPC. Used only when HELIUS_API_KEY is unset.
SOLANA_RPC_URL=
PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Preferred when set. Used before SOLANA_RPC_URL and public RPC.
HELIUS_API_KEY=
HELIUS_MAINNET_RPC_URL="https://mainnet.helius-rpc.com"

# Required for Jupiter discovery; optional for token enrichment.
JUPITER_API_KEY=

# Optional database override. Blank uses the normal database selection:
# ~/.config/growr/growr.db, or $XDG_CONFIG_HOME/growr/growr.db.
# Existing ~/.growr/growr.db is reused if the new database is absent.
GROWR_DATABASE_PATH=

# Optional provider API bases. Defaults are shown.
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1
JUPITER_API_URL=https://api.jup.ag/tokens/v2
STONKS_API_URL=https://www.stonkfun.xyz/api/public/v1
# Holder snapshots have no documented v1 endpoint. Full legacy URL:
STONKS_HOLDERS_API_URL=https://www.stonkfun.xyz/api/token-holders

# Optional. Defaults to 15 seconds.
REQUEST_TIMEOUT_SECONDS=15
